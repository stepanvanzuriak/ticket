module RegistrationsController

uses
  Std.Crypto
  Std.Http
  Std.Id
  Std.List
  Std.Map
  Std.Option
  Std.Process
  Std.Result
  Std.Time
  Models.{{Model}}
  Paths
  Schema
  Ticket.Auth
  Ticket.Conn
  Ticket.Db
  Ticket.Errors
  Ticket.Flash
  Ticket.Params
  Ticket.Response
  Ticket.Session
  Views.Layout
  Views.RegistrationViews

functions
  new(conn: Conn) -> Response / {Process, Random, Clock} {
    Session.handle(conn, blank)
  }

  create(conn: Conn) -> Response / {{{Models}}, Throws<DbFailure>, Async, Process, Random, Clock} {
    Session.handle(conn, signup)
  }

  blank(conn: Conn) -> Response {
    Response.render(
      Layout.app(conn, "Sign up", RegistrationViews.new(conn, Params.nested(conn, "{{model}}"), Errors.empty())),
    )
  }

  signup(conn: Conn) -> Response / {{{Models}}, Throws<DbFailure>, Async, Random} {
    let fields = Params.nested(conn, "{{model}}")
    let plain = Option.with_default(Map.get(fields, "password"), "")
    let confirmation = Option.with_default(Map.get(fields, "password_confirmation"), "")
    let password = Auth.validate_password(plain, confirmation)
    let digest = match password {
      Ok(valid) -> Auth.hash_password(valid),
      Err(_) -> "",
    }
    let decoded: Result<Errors, New{{Model}}> = Params.record(
      { ..conn, form: Map.insert(conn.form, "{{model}}[password_digest]", digest) },
      "{{model}}",
    )
    let checked = match password {
      Ok(_) -> Result.and_then(decoded, {{Model}}.validate),
      Err(problems) -> Err(merge(decoded, problems)),
    }

    match checked {
      Ok(row) -> {
        let created = {{Models}}.insert(row)

        Auth.finish_login(conn, Id.value(created.id), "Welcome!")
      }
      Err(errors) -> Response.render_status(
        422,
        Layout.app(conn, "Sign up", RegistrationViews.new(conn, fields, errors)),
      ),
    }
  }

  merge(decoded: Result<Errors, New{{Model}}>, problems: Errors) -> Errors {
    match decoded {
      Ok(_) -> problems,
      Err(errors) -> Errors.merge(errors, problems),
    }
  }

exports
  create
  new
