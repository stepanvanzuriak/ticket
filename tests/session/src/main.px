
module Main

uses
  Std.Crypto
  Std.Http
  Std.List
  Std.Map
  Std.Option
  Std.Time
  Ticket.Conn
  Ticket.Csrf
  Ticket.Flash
  Ticket.Forms
  Ticket.Html
  Ticket.Links
  Ticket.Response
  Ticket.Session

hosts
  Node

functions
  row(n: String, name: String, result: String) -> {} {
    Log.info("#{n} #{name}: #{result}")
  }

  t0() -> Int {
    1000000
  }

  at(now: Int, token: String) -> function(Conn) -> Response {
    Session.wrap_at(dev(), now, token, action)
  }

  dev() -> Config {
    { secret: "s3cret", max_age: 1209600, secure: false }
  }

  prod() -> Config {
    { ..dev(), secure: true }
  }

  action(conn: Conn) -> Response {
    if conn.path == "/set" {
      Response.redirect_to(Session.put(conn, "user", "ann"), "/who")
    } else if conn.path == "/who" {
      Response.text(200, Option.with_default(Session.get(conn, "user"), "nobody"))
    } else if conn.path == "/flash" {
      Response.redirect_to(Flash.put(conn, "notice", "Saved."), "/show")
    } else if conn.path == "/flash_same" {
      Response.text(
        200,
        "#{Option.with_default(Flash.get(Flash.put(conn, "notice", "x"), "notice"), "none")}",
      )
    } else if conn.path == "/show" {
      Response.text(200, Option.with_default(Flash.get(conn, "notice"), "none"))
    } else if conn.path == "/token" {
      Response.text(200, conn.csrf)
    } else if conn.path == "/big" {
      Response.redirect_to(Session.put(conn, "big", String.repeat("x", 5000)), "/")
    } else if conn.path == "/touch" {
      Response.text(200, "touched")
    } else {
      Response.text(200, "ran")
    }
  }

  request(
    app: function(Conn) -> Response / {| e},
    cookie: String,
    method: String,
    path: String,
    form: String,
    extra: List<Header>,
  ) -> Response / {| e} {
    let headers = List.append(
      [{ name: "content-type", value: "application/x-www-form-urlencoded" }],
      List.append(
        if cookie == "" { [] } else { [{ name: "cookie", value: cookie }] },
        extra,
      ),
    )
    let conn = Conn.with_method_override(
      Conn.from_request(
        { method: method, path: path, query: "", headers: headers, body: form },
      ),
    )

    Conn.for_head(conn, app(conn))
  }

  get(
    app: function(Conn) -> Response / {| e},
    cookie: String,
    path: String,
  ) -> Response / {| e} {
    request(app, cookie, "GET", path, "", [])
  }

  jar(response: Response) -> String {
    match List.filter(response.headers, function(h) { h.name == "set-cookie" }) {
      [first, .._] -> match String.split(first.value, ";") {
        [pair, .._] -> pair,
        [] -> "",
      },
      [] -> "",
    }
  }

  cookies(response: Response) -> List<String> {
    List.map(
      List.filter(response.headers, function(h) { h.name == "set-cookie" }),
      function(h) { h.value },
    )
  }

  attributes(response: Response) -> String {
    List.join(
      List.map(
        cookies(response),
        function(c) { String.replace(c, jar_of(c), "_ticket_session=…") },
      ),
      " | ",
    )
  }

  jar_of(cookie: String) -> String {
    match String.split(cookie, ";") {
      [pair, .._] -> pair,
      [] -> "",
    }
  }

  summary(response: Response) -> String {
    "#{Int.to_string(response.status)} #{response.body}"
  }

  main() -> {} / {Random, Clock} {
    let app = at(t0(), "tok-A")
    let first = get(app, "", "/touch")
    let again = get(app, jar(first), "/token")
    let again2 = get(app, jar(first), "/token")

    row("1", "first_gets_cookie", "#{List.length(cookies(first))} cookie")
    row("1", "round_trip", "#{again.body == again2.body} #{again.body}")

    let set = get(app, jar(first), "/set")

    row(
      "1",
      "put_then_get",
      "#{summary(get(app, jar(set), "/who"))} (set #{List.length(cookies(set))} cookie)",
    )

    let cookie = jar(set)
    let flipped = String.replace(cookie, "_ticket_session=", "_ticket_session=A")
    let resigned = "#{jar_of(cookie)}0"

    row("2", "tampered_payload", summary(get(app, flipped, "/who")))
    row("2", "bad_signature", summary(get(app, resigned, "/who")))
    row("2", "not_base64url", summary(get(app, "_ticket_session=!!!.abc", "/who")))
    row("2", "no_dot", summary(get(app, "_ticket_session=abc", "/who")))
    row(
      "2",
      "other_secret",
      summary(
        get(
          Session.wrap_at({ ..dev(), secret: "another" }, t0(), "tok-A", action),
          cookie,
          "/who",
        ),
      ),
    )

    row(
      "3",
      "expired",
      summary(get(at(t0() + 1209600 * 1000 + 1, "tok-A"), cookie, "/who")),
    )
    row(
      "3",
      "not_yet_expired",
      summary(get(at(t0() + 1209600 * 1000 - 1, "tok-A"), cookie, "/who")),
    )

    row("4", "attributes", attributes(first))
    row(
      "5",
      "secure_in_production",
      attributes(get(Session.wrap_at(prod(), t0(), "tok-A", action), "", "/touch")),
    )

    let two = Response.add_header(
      Response.add_header(Response.text(200, ""), "set-cookie", "a=1"),
      "set-cookie",
      "b=2",
    )
    let replaced = Response.with_header(two, "set-cookie", "c=3")

    row(
      "6",
      "two_cookies",
      "#{List.length(cookies(two))} then #{List.length(cookies(replaced))}",
    )

    let flashed = get(app, jar(first), "/flash")
    let shown = get(app, jar(flashed), "/show")
    let after = get(app, jar(shown), "/show")

    row("7", "flash_next_request", "#{summary(shown)}, then #{summary(after)}")
    row(
      "9",
      "flash_cleared_by_render",
      "#{List.length(cookies(shown))} cookie on the displaying response, then #{List.length(cookies(get(app, jar(shown), "/touch")))}",
    )
    row("10", "flash_same_request", summary(get(app, jar(first), "/flash_same")))
    row(
      "1",
      "no_change_no_cookie",
      "#{List.length(cookies(get(app, jar(first), "/touch")))} cookies",
    )

    let token = again.body
    let posted = function(cookie, form, extra) {
      request(app, cookie, "POST", "/touch", form, extra)
    }

    row("11", "csrf_get_passes", summary(get(app, "", "/touch")))
    row(
      "12",
      "csrf_field_passes",
      summary(posted(jar(first), "authenticity_token=#{token}", [])),
    )
    row(
      "13",
      "csrf_header_passes",
      summary(posted(jar(first), "", [{ name: "x-csrf-token", value: token }])),
    )
    row(
      "13",
      "csrf_override_passes",
      summary(
        request(
          app,
          jar(first),
          "POST",
          "/touch",
          "_method=delete&authenticity_token=#{token}",
          [],
        ),
      ),
    )
    row("14", "csrf_missing", summary(posted(jar(first), "", [])))
    row(
      "15",
      "csrf_wrong",
      summary(posted(jar(first), "authenticity_token=token-99", [])),
    )
    row(
      "16",
      "csrf_no_session",
      summary(
        request(
          at(t0(), "tok-B"),
          "",
          "POST",
          "/touch",
          "authenticity_token=#{token}",
          [],
        ),
      ),
    )
    row(
      "16",
      "csrf_unprotected",
      summary(
        request(Session.wrap_unprotected(dev(), action), "", "POST", "/touch", "", []),
      ),
    )
    row(
      "17",
      "csrf_stable",
      "#{token == get(at(t0() + 5, "tok-B"), jar(set), "/token").body}",
    )
    row("18", "csrf_differs", "#{token != get(at(t0(), "tok-B"), "", "/token").body}")

    let page = Conn.from_request(
      { method: "GET", path: "/", query: "", headers: [], body: "" },
    )
    let loaded = { ..page, csrf: "abc\"<" }

    row("19", "form_field", Html.to_string(Csrf.field(loaded)))
    row("19", "meta", Html.to_string(Csrf.meta(loaded)))
    row(
      "19",
      "button_field",
      Html.to_string(
        Links.button_to({ conn: loaded, text: "Delete", path: "/p/1", method: "delete" }),
      ),
    )
    row(
      "19",
      "get_form_has_none",
      Html.to_string(
        Forms.method_form(
          { conn: loaded, action: "/", method: "get", children: Html.raw("") },
        ),
      ),
    )
    row("20", "too_big", summary(get(app, jar(first), "/big")))
  }

exports
  main
