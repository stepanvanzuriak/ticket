module Schema

uses
  Std.Id
  Std.Json
  Std.List
  Std.Option
  Std.Result
  Std.Time
  Ticket.Db
  Ticket.Form
  Ticket.Migration
  Ticket.Model
  Ticket.Query

hosts
  Node

migrations
  20261001_120000 create_table users
    name   String
    email  String  unique

  20261001_130000 create_table posts
    title      String
    published  Bool              default false
    score      Float             default 0
    author_id  Option<Id<User>>  references users
    timestamps

  20261001_140000 create_table events
    name     String
    seen_at  Option<Time>
