module Main

uses
  Std.Http
  Std.List
  Std.Option
  Std.Result
  Std.Time
  Ticket.Db
  Ticket.Migrate
  Schema

hosts
  Node

functions
  migrate(command: String, step: Int, version: String) -> Int / {Db, Clock} {
    Migrate.run(Schema.migrations, command, step, version)
  }

  seed() -> {} / {Db} {
    let _ = Db.exec(
      "INSERT INTO users (name, email) VALUES (?, ?)",
      [SqlText("Ada"), SqlText("ada@example.com")],
    )

    Log.info("seeded")
  }

  router(request: Request) -> Option<Response> {
    None
  }

exports
  migrate
  router
  seed
