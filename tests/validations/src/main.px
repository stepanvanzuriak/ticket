
module Main

uses
  Std.List
  Std.Option
  Std.Result
  Ticket.Db
  Ticket.Errors
  Ticket.Conn
  Ticket.Migration
  Ticket.Params
  Post
  Schema

hosts
  Node

functions
  row(n: Int, name: String, result: String) -> {} {
    Log.info("#{n} #{name}: #{result}")
  }

  new_post(title: String, status: String, slug: String, summary: Option<String>, views: Int) -> NewPost {
    { title: title, status: status, slug: slug, summary: summary, views: views }
  }

  valid() -> NewPost {
    new_post("Hello", "draft", "hello", None, 1)
  }

  outcome(result: Result<Errors, r>) -> String {
    match result {
      Ok(_) -> "Ok",
      Err(errors) -> "Err(#{List.join(Errors.full_messages(errors), "; ")})",
    }
  }

  form(body: String) -> Conn {
    let headers = [
      { name: "Content-Type", value: "application/x-www-form-urlencoded" },
    ]

    Conn.from_request({ method: "POST", path: "/", query: "", headers: headers, body: body })
  }

  submitted(body: String) -> String / {Posts, Throws<DbFailure>} {
    let decoded: Result<Errors, NewPost> = Params.record(form(body), "post")

    outcome(Result.and_then(decoded, Post.validate))
  }

  setup() -> {} / {Db} {
    let _ = Db.connect({ adapter: "sqlite", database: ":memory:" })

    List.fold(
      Schema.migrations,
      {},
      function(_, m) { List.fold(Migration.up_sql(m), {}, function(_, s) {
          let _ = Db.script(s)

          {}
        }) },
    )
  }

  main() -> {} / {Posts, Db, Throws<DbFailure>} {
    setup()

    row(1, "valid", outcome(Post.validate(valid())))
    row(2, "presence", outcome(Post.validate({ ..valid(), title: "  ", slug: "" })))
    row(3, "length", "#{outcome(Post.validate({ ..valid(), title: "ab" }))} | #{outcome(Post.validate({ ..valid(), title: "a" }))} | #{outcome(Post.validate({ ..valid(), title: String.repeat("x", 121) }))} | #{outcome(Post.validate({ ..valid(), title: String.repeat("x", 120) }))}")
    row(4, "inclusion", "#{outcome(Post.validate({ ..valid(), status: "archived" }))} | #{outcome(Post.validate({ ..valid(), views: 3 }))} | #{outcome(Post.validate({ ..valid(), views: 2 }))}")
    row(5, "length_option", "#{outcome(Post.validate({ ..valid(), summary: Some("short") }))} | #{outcome(Post.validate({ ..valid(), summary: Some("far too long for this") }))}")
    row(6, "all_errors_in_order", outcome(Post.validate(new_post("", "x", "", None, 9))))

    let saved = Posts.insert(valid())

    row(7, "uniqueness_new", "#{outcome(Post.validate(valid()))} | #{outcome(Post.validate({ ..valid(), slug: "other" }))}")
    row(8, "uniqueness_update_self", outcome(Post.validate_update(saved)))

    let other = Posts.insert({ ..valid(), slug: "other" })

    row(9, "uniqueness_update_other", outcome(Post.validate_update({ ..other, slug: "hello" })))
    row(10, "update_rules", outcome(Post.validate_update({ ..saved, title: "x" })))
    row(11, "form_then_validate", "#{submitted("post[title]=Fine&post[status]=live&post[slug]=fresh&post[views]=2")} | #{submitted("post[title]=No&post[status]=live&post[slug]=fresh&post[views]=2")} | #{submitted("post[title]=Fine&post[status]=live&post[slug]=hello&post[views]=lots")} | #{submitted("post[title]=Fine&post[status]=live&post[slug]=hello&post[views]=1")}")

    row(12, "format", "#{outcome(Post.validate({ ..valid(), slug: "Not A Slug" }))} | #{outcome(Post.validate({ ..valid(), slug: "a-b-1" }))}")
  }

exports
  main
