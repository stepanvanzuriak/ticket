module Post

uses
  Std.List
  Std.Result
  Ticket.Db
  Ticket.Errors
  Ticket.Query
  Ticket.Validations
  Schema

validations
  title    presence  length 3..120
  status   inclusion "draft" "live"
  slug     presence  format "^[a-z0-9-]*$"  uniqueness
  summary  length ..10
  views    inclusion 0 1 2
