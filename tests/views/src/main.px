
module Main

uses
  Std.List
  Std.Option
  Aliased
  Cards
  Items
  Layout
  Ported
  Ticket.Html

functions
  row(n: String, name: String, html: Html) -> {} {
    Log.info("#{n} #{name}: #{Html.to_string(html)}")
  }

  main() {
    let post = { id: 1, title: "Hi & <bye>" }

    row("1", "ported card", Ported.card(post))
    row("1", "ported spaces", Ported.spaces(post))
    row("1", "ported characters", Ported.characters())
    row("1", "ported comment", Ported.comment())
    row("1", "ported void", Ported.void())
    row("1", "ported framed", Ported.framed(post))
    row("3", "alias_import", Aliased.card({ id: 1, title: "Hi & <bye>" }))
    row("4", "render_bool_float", Cards.bool_float())
    row("5", "attr_literal", Cards.literal())
    row("6", "attr_bool_true", Cards.disabled(true))
    row("7", "attr_bool_false", Cards.disabled(false))
    row("8", "attr_option_none", Cards.titled(None))
    row("8", "attr_option_some", Cards.titled(Some("t")))
    row("9", "attr_escaped", Cards.quoted())
    Log.info(
      "10 layout_from_controller: #{Html.document(Layout.app("T", Items.list(["a", "b"])))}",
    )
  }

exports
  main
