module Schema

uses
  Std.{Id, Json, List, Option, Result, Time}
  Ticket.{Db, Form, Migration, Model, Query}

hosts
  Node

migrations
  20261001_120000 create_table users
    name   String
    email  String  unique

  20261001_130000 create_table items
    name      String
    count     Int
    price     Float
    active    Bool
    note      Option<String>
    owner_id  Option<Id<User>>  references users
    due       Option<Time>
    timestamps
