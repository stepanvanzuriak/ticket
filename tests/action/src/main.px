
module Main

uses
  Std.Http
  Std.List
  Std.Ref
  Std.Result
  Ticket.Action
  Ticket.Conn
  Ticket.Error
  Ticket.Html
  Ticket.Response

functions
  conn(method: String) -> Conn {
    Conn.from_request({ method: method, path: "/", query: "", headers: [], body: "" })
  }

  show(response: Response) -> String {
    let headers = List.map(response.headers, function(h) { "#{h.name}: #{h.value}" })

    "#{Int.to_string(response.status)} [#{List.join(headers, ", ")}] #{response.body}"
  }

  step(runs: Ref<Int>, name: String) -> function(Conn) -> Result<Response, Conn> / {Mut} {
    function(c) {
      Ref.update(runs, function(n) { n + 1 })

      let trail = Conn.header(c, "x-trail")
      let request = c.request
      let headers = [{ name: "x-trail", value: "#{trail}#{name}" }]

      Ok({ ..c, request: { ..request, headers: headers } })
    }
  }

  stop(c: Conn) -> Result<Response, Conn> {
    Err(Response.text(401, "halted"))
  }

  echo(runs: Ref<Int>) -> function(Conn) -> Response / {Mut} {
    function(c) {
      Ref.update(runs, function(n) { n + 1 })
      Response.text(200, "action saw #{Conn.header(c, "x-trail")}")
    }
  }

  deep(n: Int) -> String / {Throws<Halt>} {
    if n > 1 { throw Halt(Response.not_found()) } else { "fine" }
  }

  main() {
    let runs = Ref.new(0)
    Log.info("14 before_empty: #{show(Action.before([], echo(runs))(conn("GET")))}")

    Log.info(
      "14 before_order: #{show(Action.before([step(runs, "a"), step(runs, "b")], echo(runs))(conn("GET")))}",
    )

    Ref.set(runs, 0)
    Log.info(
      "14 before_halt: #{show(Action.before([step(runs, "a"), stop, step(runs, "b")], echo(runs))(conn("GET")))} (runs: #{Int.to_string(Ref.get(runs))})",
    )

    let filters: List<Filter> = [stop]

    Log.info(
      "14 before_alias: #{show(Action.before(filters, function(c) { Response.text(200, "ran") })(conn("GET")))}",
    )

    let typed = Response.text(200, "x")

    Log.info(
      "15 with_header_replace: #{show(Response.with_header(typed, "Content-Type", "text/csv"))}",
    )
    Log.info("15 with_header_append: #{show(Response.with_header(typed, "x-a", "1"))}")
    Log.info(
      "15 with_header_duplicates: #{show(Response.with_header({ ..typed, headers: [{ name: "X-A", value: "1" }, { name: "x-a", value: "2" }] }, "x-a", "3"))}",
    )
    Log.info(
      "15 content_type: #{show(Response.content_type(Response.empty(200), "text/csv"))}",
    )

    Log.info("+ render: #{show(Response.render(Html.raw("<p>hi</p>")))}")
    Log.info(
      "+ render_status: #{show(Response.render_status(422, Html.raw("<p>no</p>")))}",
    )
    Log.info("+ redirect_get: #{show(Response.redirect_to(conn("GET"), "/a"))}")
    Log.info("+ redirect_head: #{show(Response.redirect_to(conn("HEAD"), "/a"))}")
    Log.info("+ redirect_post: #{show(Response.redirect_to(conn("POST"), "/a"))}")
    Log.info("+ redirect_delete: #{show(Response.redirect_to(conn("delete"), "/a"))}")
    Log.info("+ head: #{show(Response.head(204))}")

    Log.info(
      "+ halt_deep: #{show(Conn.rescue_halt(function() { Response.text(200, deep(2)) }))}",
    )
    Log.info(
      "+ halt_none: #{show(Conn.rescue_halt(function() { Response.text(200, deep(1)) }))}",
    )
  }

exports
  main
