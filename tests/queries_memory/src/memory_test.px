module MemoryTest

uses
  Std.Assert
  Std.Id
  Std.List
  Std.Option
  Std.Table
  Ticket.Db
  Ticket.Query
  Schema

hosts
  Node

constants
  store: Table<Post> = Table.new()

binds
  Posts in Node {
    find(id) {
      Table.find(store, Id.value(id))
    }

    all() {
      Table.all(store)
    }

    filter(_, _) {
      Table.all(store)
    }

    count(_) {
      List.length(Table.all(store))
    }

    insert(row) {
      Table.insert(
        store,
        function(n) { { id: Id(n), title: row.title, published: row.published } },
      )
    }

    update(row) {
      let _ = Table.update(store, Id.value(row.id), row)

      row
    }

    delete(id) {
      Table.delete(store, Id.value(id))
    }
  }

functions
  titles(posts: List<Post>) -> String {
    List.join(List.map(posts, function(p) { p.title }), ", ")
  }

  test_insert_find_update_delete() -> {} / {
    Posts,
    Mut,
    Throws<DbFailure>,
    Throws<Failed>,
  } {
    let a = Posts.insert({ title: "a", published: true })
    let _ = Posts.insert({ title: "b", published: false })

    Assert.equal(a.id, Id(1))
    Assert.equal(Option.map(Posts.find(a.id), function(p) { p.title }), Some("a"))
    Assert.equal(titles(Posts.all()), "a, b")
    Assert.equal(Posts.count([]), 2)
    Assert.equal(Posts.update({ ..a, title: "A" }).title, "A")
    Assert.equal(Posts.delete(a.id), true)
    Assert.equal(Posts.count([Query.eq(Schema.post_published, true)]), 1)
  }

exports
  test_insert_find_update_delete
