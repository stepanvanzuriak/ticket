
module Main

uses
  Std.Http
  Std.Id
  Std.List
  Std.Option
  Routes

functions
  row(n: Int, name: String, result: String) -> {} {
    Log.info("#{n} #{name}: #{result}")
  }

  table(n: Int, name: String, controller: String) -> {} {
    let rows = List.filter(
      Routes.route_table,
      function(r) {
        String.starts_with(r.action, "#{controller}.")
          && r.action != "PostsController.publish"
          && r.action != "PostsController.drafts"
      },
    )

    row(n, name, "#{List.length(rows)} rows")
    List.fold(
      rows,
      {},
      function(_, r) {
        Log.info("  #{r.method} #{r.path} #{r.action} #{name_of(r.name)}")
      },
    )
  }

  name_of(name: String) -> String {
    if name == "" { "-" } else { name }
  }

  only_except() -> String {
    let count = function(controller) {
      List.length(
        List.filter(
          Routes.route_table,
          function(r) { String.starts_with(r.action, "#{controller}.") },
        ),
      )
    }

    "only create destroy: #{count("CommentsController")} rows, except destroy: #{count("UsersController")} rows"
  }

  member_and_collection() -> String {
    let rows = List.filter(
      Routes.route_table,
      function(r) {
        r.action == "PostsController.publish" || r.action == "PostsController.drafts"
      },
    )

    List.join(List.map(rows, function(r) { "#{r.method} #{r.path} #{r.name}" }), ", ")
  }

  head(path: String) -> String {
    let request = { method: "HEAD", path: path, query: "", headers: [], body: "" }

    match Routes.router(request) {
      Some(
        response,
      ) -> "#{response.status} body=\"#{response.body}\" headers=#{List.length(response.headers)}",
      None -> "None",
    }
  }

  main() {
    table(6, "table_resources", "PostsController")
    row(7, "table_only_except", only_except())
    table(8, "table_nested", "CommentsController")
    row(9, "table_member_collection", member_and_collection())
    table(10, "table_namespace", "UsersController")
    row(
      20,
      "helper_names_and_values",
      List.join(
        [
          Routes.root_path(),
          Routes.about_path(),
          Routes.webhook_path("github"),
          Routes.posts_path(),
          Routes.new_post_path(),
          Routes.post_path(Id(3)),
          Routes.edit_post_path(Id(3)),
          Routes.post_comments_path(Id(2)),
          Routes.post_comment_path(Id(2), Id(9)),
          Routes.publish_post_path(Id(3)),
          Routes.drafts_posts_path(),
          Routes.admin_users_path(),
          Routes.new_admin_user_path(),
          Routes.admin_user_path(Id(4)),
          Routes.edit_admin_user_path(Id(4)),
        ],
        " ",
      ),
    )
    row(21, "helper_encodes", Routes.webhook_path("a b"))
    row(15, "head_as_get (router)", head("/about"))
  }

exports
  main
