module Main

uses
  Std.Json
  Std.List
  Std.Option
  Std.Result
  Ticket.Db

types
  Count = { n: Int } derive(Json)

functions
  shown(result: Result<DbError, a>, show: function(a) -> String) -> String {
    match result {
      Ok(value) -> "Ok(#{show(value)})",
      Err(
        error,
      ) -> "Err(kind=#{error.kind} code=#{error.code} message=#{error.message} sql=#{error.sql})",
    }
  }

  unit(_: {}) -> String {
    "{}"
  }

  changes(c: Changes) -> String {
    "changes=#{c.changes} last_id=#{c.last_id}"
  }

  counter_setup() -> String / {Db} {
    shown(
      Db.script(
        "create table counter (n integer not null); insert into counter values (0)",
      ),
      unit,
    )
  }

  bump() -> String / {Db} {
    let bumped: Result<DbError, Changes> = Db.transaction(
      function() {
        let n = count_value()

        Db.exec("update counter set n = ?", [SqlInt(n + 1)])
      },
    )

    shown(bumped, changes)
  }

  counter() -> String / {Db} {
    let read: Result<DbError, Option<Count>> = Db.one("select n from counter", [])

    shown(
      read,
      function(c) { "#{Option.with_default(Option.map(c, function(r) { r.n }), -1)}" },
    )
  }

  count_value() -> Int / {Db} {
    let read: Result<DbError, Option<Count>> = Db.one("select n from counter", [])

    match read {
      Ok(Some(c)) -> c.n,
      _ -> -1,
    }
  }

exports
  counter_setup
  bump
  counter
