
module Main

uses
  Std.Fs
  Std.List
  Std.Option
  Std.Path
  Std.Process
  Std.Result
  Args
  App
  Ticket.Inflect

hosts
  Node

functions
  row(n: Int, name: String, result: String) -> {} {
    Log.info("#{n} #{name}: #{result}")
  }

  show_option(option: Option<String>) -> String {
    match option {
      Some(value) -> "Some(\"#{value}\")",
      None -> "None",
    }
  }

  show_parsed(result: Result<ArgError, Parsed>) -> String {
    match result {
      Err(UnknownFlag(name)) -> "Err(UnknownFlag(\"#{name}\"))",
      Err(MissingValue(name)) -> "Err(MissingValue(\"#{name}\"))",
      Ok(parsed) -> {
        let flags = List.map(
          parsed.flags,
          function(f) {
            match f.value {
              Some(value) -> "#{f.name}=#{value}",
              None -> f.name,
            }
          },
        )

        "command=#{parsed.command} positional=[#{List.join(parsed.positional, ", ")}] flags=[#{List.join(flags, ", ")}]"
      }
    }
  }

  fixtures(base: String) -> Result<FsError, {}> / {Fs} {
    Fs.remove_all(base)
      |> Result.and_then(
        function(_) { Fs.mkdir_all(Path.join(base, "demo/src/controllers")) },
      )
      |> Result.and_then(function(_) { Fs.mkdir_all(Path.join(base, "plain/src")) })
      |> Result.and_then(
        function(_) {
          Fs.write(
            Path.join(base, "demo/polar.toml"),
            "[project]\nname = \"demo\"\n\n[dependencies]\nticket = { path = \"../ticket\" }\n",
          )
        },
      )
      |> Result.and_then(
        function(_) {
          Fs.write(
            Path.join(base, "plain/polar.toml"),
            "[project]\nname = \"plain\"\n\n[run]\nticket = \"not a dependency\"\n",
          )
        },
      )
  }

  relative_root(base: String, from: String) -> String / {Fs} {
    show_option(
      Option.map(
        App.root(Path.join(base, from)),
        function(root) { Path.relative(base, root) },
      ),
    )
  }

  main() -> {} / {Fs, Process} {
    row(
      1,
      "args_forms",
      show_parsed(Args.parse(["s", "-p", "1", "--x=2", "--skip-build"])),
    )

    let forms = Args.parse(["s", "-p", "1", "--x=2", "--skip-build"])

    match forms {
      Ok(parsed) -> row(
        1,
        "args_forms_lookup",
        "port=#{show_option(Args.flag(parsed, "port"))} x=#{show_option(Args.flag(parsed, "x"))} skip-build=#{Bool.to_string(Args.has(parsed, "skip-build"))} help=#{Bool.to_string(Args.has(parsed, "help"))}",
      ),
      Err(_) -> row(1, "args_forms_lookup", "parse failed"),
    }
    row(2, "args_missing_value", show_parsed(Args.parse(["s", "--port"])))

    let base = Path.join(
      Option.with_default(Process.env("TMPDIR"), "/tmp"),
      "ticket-cli-tests",
    )

    match fixtures(base) {
      Ok(_) -> {
        row(6, "root_from_nested", relative_root(base, "demo/src/controllers"))
        row(6, "root_at_app", relative_root(base, "demo"))
        row(6, "root_not_ticket", relative_root(base, "plain/src"))
      }
      Err(error) -> row(6, "root_from_nested", "fixtures failed: #{error.message}"),
    }

    let _ = Fs.remove_all(base)

    let plurals = List.map(
      ["post", "category", "box", "day"],
      function(w) { "#{w} -> #{Inflect.plural(w)}" },
    )
    let singulars = List.map(
      ["posts", "categories", "people", "s", "ies"],
      function(w) { "#{w} -> #{show_option(Inflect.singular(w))}" },
    )

    row(17, "inflect_plural", List.join(plurals, ", "))
    row(17, "inflect_singular", List.join(singulars, ", "))
    row(
      17,
      "inflect_case",
      "blog_posts -> #{Option.with_default(Option.map(Inflect.singular("blog_posts"), Inflect.pascal), "None")}, BlogPost -> #{Inflect.plural(Inflect.snake("BlogPost"))}, blog_post -> #{Inflect.pascal("blog_post")}",
    )

    row(18, "args_long_value", show_parsed(Args.parse(["server", "--port", "4000"])))
    row(19, "args_equals_value", show_parsed(Args.parse(["server", "--port=4000"])))
    row(
      20,
      "args_value_is_flag",
      show_parsed(Args.parse(["server", "-p", "--skip-build"])),
    )
    row(21, "args_unknown_flag", show_parsed(Args.parse(["new", "demo", "--frobnicate"])))
    row(22, "args_aliases", show_parsed(Args.parse(["g", "model"])))
    row(23, "args_dashdash", show_parsed(Args.parse(["new", "--", "--skip-build"])))
    row(24, "args_empty", show_parsed(Args.parse([])))
  }

exports
  Node
  main
