
module Main

uses
  Std.Id
  Std.List
  Std.Option
  Std.Result
  Ticket.Db
  Ticket.Migration
  Ticket.Query
  Schema

hosts
  Node

functions
  row(n: Int, name: String, result: String) -> {} {
    Log.info("#{n} #{name}: #{result}")
  }

  titles(posts: List<Post>) -> String {
    "[#{List.join(List.map(posts, function(p) { p.title }), ", ")}]"
  }

  bodies(comments: List<Comment>) -> String {
    "[#{List.join(List.map(comments, function(c) { c.body }), ", ")}]"
  }

  name_of(user: Option<User>) -> String {
    match user {
      Some(u) -> u.name,
      None -> "none",
    }
  }

  new_post(title: String, author: Id<User>, editor: Option<Id<User>>) -> NewPost {
    { title: title, author_id: author, editor_id: editor }
  }

  new_comment(body: String, post: Id<Post>, parent: Option<Id<Comment>>) -> NewComment {
    { body: body, post_id: post, parent_id: parent }
  }

  caught(body: function() -> String / {Posts, Users, Comments, Notes, Db, Throws<DbFailure>}) -> String / {Posts, Users, Comments, Notes, Db} {
    try {
      body()
    } catch {
      DbFailure(error) -> "Err(kind=#{error.kind})",
    }
  }

  setup() -> {} / {Db} {
    let _ = Db.connect({ adapter: "sqlite", database: ":memory:" })

    List.fold(
      Schema.migrations,
      {},
      function(_, m) { List.fold(Migration.up_sql(m), {}, function(_, s) {
          let _ = Db.script(s)

          {}
        }) },
    )
  }

  main() -> {} / {Posts, Users, Comments, Notes, Db, Throws<DbFailure>} {
    setup()

    let ada = Users.insert({ name: "Ada" })
    let bob = Users.insert({ name: "Bob" })
    let first = Posts.insert(new_post("First", ada.id, Some(bob.id)))
    let second = Posts.insert(new_post("Second", ada.id, None))
    let third = Posts.insert(new_post("Third", bob.id, None))

    row(1, "belongs_to", Schema.post_author(first).name)
    row(2, "belongs_to_option", "#{name_of(Schema.post_editor(first))} #{name_of(Schema.post_editor(second))}")
    row(3, "has_many", "#{titles(Schema.user_posts_as_author(ada))} #{titles(Schema.user_posts_as_author(bob))}")
    row(4, "two_references", "#{titles(Schema.user_posts_as_author(bob))} #{titles(Schema.user_posts_as_editor(bob))}")
    row(5, "has_many_filter", titles(Schema.user_posts_as_author_filter(ada, [Query.eq(Schema.post_title, "Second")], [])))
    row(6, "has_many_order", titles(Schema.user_posts_as_author_filter(ada, [], [Query.order_desc(Schema.post_id)])))

    let note = Notes.insert({ body: "Hi", user_id: ada.id })

    row(7, "conventional_name", "#{List.length(Schema.user_notes(ada))} #{List.length(Schema.user_notes(bob))} #{Schema.note_user(note).name}")

    let c1 = Comments.insert(new_comment("c1", first.id, None))
    let c2 = Comments.insert(new_comment("c2", first.id, Some(c1.id)))
    let _ = Comments.insert(new_comment("c3", second.id, None))

    row(8, "has_many_by_post", bodies(Schema.post_comments(first)))
    row(9, "self_reference", "#{bodies(Schema.comment_comments_as_parent(c1))} #{Schema.comment_post(c2).title}")
    row(10, "root_has_no_parent", "#{match Schema.comment_parent(c1) { Some(_) -> "some", None -> "none" }} #{match Schema.comment_parent(c2) { Some(p) -> p.body, None -> "none" }}")
    row(11, "restrict_default", caught(function() { Users.delete(ada.id) |> function(b) { "#{b}" } }))

    let _ = Notes.delete(note.id)

    row(12, "cascade", "#{Posts.delete(first.id)} #{Comments.count([])} #{Posts.count([])}")
    let fourth = Posts.insert(new_post("Fourth", ada.id, Some(bob.id)))

    row(13, "set_null", "#{Users.delete(bob.id)} #{Posts.count([])} #{match Posts.find(fourth.id) { Some(p) -> name_of(Schema.post_editor(p)), None -> "gone" }}")
  }

exports
  main
