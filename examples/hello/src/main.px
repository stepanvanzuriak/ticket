module Main

uses
  Std.{Http, Option}
  Layout
  Pages
  Ticket.{Html, Response}

hosts
  Node

functions
  router(request: Request) -> Option<Response> {
    if request.path == "/" {
      Some(Response.html(200, Html.document(Layout.app("Hello", Pages.home("Ticket")))))
    } else {
      None
    }
  }

exports
  router
