module SessionsController

uses
  Std.{Http, Id, List, Option}
  Paths
  Schema
  Ticket.{Auth, Conn, Db, Flash, Params, Query, Response, Session}
  Views.{Layout, SessionViews}

functions
  new(conn: Conn) -> Response / {..} {
    Session.handle(conn, blank)
  }

  create(conn: Conn) -> Response / {..} {
    Session.handle(conn, attempt)
  }

  destroy(conn: Conn) -> Response / {..} {
    Session.handle(conn, leave)
  }

  blank(conn: Conn) -> Response {
    Response.render(Layout.app(conn, "Log in", SessionViews.new(conn, "", "")))
  }

  attempt(conn: Conn) -> Response / {..} {
    let email = Option.with_default(Params.string(conn, "email"), "")
    let password = Option.with_default(Params.string(conn, "password"), "")
    let found = List.head(Users.filter([Query.eq(Schema.user_email, email)], []))
    let digest = Option.map(found, function(user) { user.password_digest })

    match found {
      Some(user) -> if Auth.check(password, digest) {
        Auth.finish_login(conn, Id.value(user.id), "Logged in.")
      } else {
        refuse(conn, email)
      },
      None -> {
        let _ = Auth.check(password, digest)

        refuse(conn, email)
      }
    }
  }

  refuse(conn: Conn, email: String) -> Response {
    Response.render_status(
      422,
      Layout.app(
        conn,
        "Log in",
        SessionViews.new(conn, email, "Invalid email or password."),
      ),
    )
  }

  leave(conn: Conn) -> Response {
    Response.redirect_to(
      Flash.put(Auth.logout(conn), "notice", "Logged out."),
      Paths.root_path(),
    )
  }

exports
  create
  destroy
  new
