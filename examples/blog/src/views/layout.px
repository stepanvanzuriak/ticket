module Layout

uses
  Std.Option
  Paths
  Ticket.Auth
  Ticket.Conn
  Ticket.Csrf
  Ticket.Flash
  Ticket.Html

views
  app(conn: Conn, title: String, body: Html)
    <html>
      <head>
        <meta charset="utf-8" />
        <title>{title}</title>
        <link rel="stylesheet" href="/app.css" />
        {Csrf.meta(conn)}
      </head>
      <body>
        <nav>
          <a href={Paths.root_path()}>Ticket blog</a>
          <a href={Paths.new_post_path()}>New post</a>
          {account(conn)}
        </nav>
        {flash(conn, "notice")}
        {flash(conn, "alert")}
        <main>{body}</main>
      </body>
    </html>

functions
  account(conn: Conn) -> Html {
    match Auth.current_user_id(conn) {
      Some(_) -> Html.raw(
        "<form action=\"#{Paths.logout_path()}\" method=\"post\"><input type=\"hidden\" name=\"_method\" value=\"delete\">#{Html.to_string(Csrf.field(conn))}<button type=\"submit\">Log out</button></form>",
      ),
      None -> Html.raw(
        "<a href=\"#{Paths.login_path()}\">Log in</a> <a href=\"#{Paths.signup_path()}\">Sign up</a>",
      ),
    }
  }

  flash(conn: Conn, key: String) -> Html {
    match Flash.get(conn, key) {
      Some(text) -> Html.raw("<p class=\"#{key}\">#{Html.escape(text)}</p>"),
      None -> Html.raw(""),
    }
  }

exports
  app
