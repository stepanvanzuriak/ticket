module Migration

uses
  Std.{List, Option}
  Ticket.Db

types
  ColumnKind = IntColumn | FloatColumn | TextColumn | BoolColumn | TimeColumn | NowColumn

  Column = {
    name: String,
    kind: ColumnKind,
    nullable: Bool,
    default: Option<SqlValue>,
    references: Option<String>,
    on_delete: Option<String>,
  }

  Index = { name: String, table: String, columns: List<String>, unique: Bool }

  Change =
    | CreateTable(String, List<Column>)
    | DropTable(String)
    | AddColumn(String, Column)
    | RemoveColumn(String, String)
    | RenameColumn(String, String, String)
    | AddIndex(Index)
    | RemoveIndex(Index)

  Migration = { version: String, name: String, up: List<Change>, down: List<Change> }

functions
  up_sql(migration: Migration) -> List<String> {
    up_sql_for(migration, "sqlite")
  }

  down_sql(migration: Migration) -> List<String> {
    down_sql_for(migration, "sqlite")
  }

  up_sql_for(migration: Migration, dialect: String) -> List<String> {
    List.map(migration.up, function(change) { sql_for(change, dialect) })
  }

  down_sql_for(migration: Migration, dialect: String) -> List<String> {
    List.map(migration.down, function(change) { sql_for(change, dialect) })
  }

  sql(change: Change) -> String {
    sql_for(change, "sqlite")
  }

  sql_for(change: Change, dialect: String) -> String {
    match change {
      CreateTable(table, columns) -> {
        let defined = List.join(
          [primary_key(dialect), ..List.map(columns, function(c) { column_sql(c, dialect) })],
          ", ",
        )

        "CREATE TABLE #{quote(table)} (#{defined})"
      }
      DropTable(table) -> "DROP TABLE #{quote(table)}",
      AddColumn(
        table,
        column,
      ) -> "ALTER TABLE #{quote(table)} ADD COLUMN #{column_sql(column, dialect)}",
      RemoveColumn(
        table,
        name,
      ) -> "ALTER TABLE #{quote(table)} DROP COLUMN #{quote(name)}",
      RenameColumn(
        table,
        from,
        to,
      ) -> "ALTER TABLE #{quote(table)} RENAME COLUMN #{quote(from)} TO #{quote(to)}",
      AddIndex(index) -> {
        let unique = if index.unique { "UNIQUE " } else { "" }
        let columns = List.join(List.map(index.columns, quote), ", ")

        "CREATE #{unique}INDEX #{quote(index.name)} ON #{quote(index.table)} (#{columns})"
      }
      RemoveIndex(index) -> "DROP INDEX #{quote(index.name)}",
    }
  }

  primary_key(dialect: String) -> String {
    if dialect == "postgres" {
      "\"id\" BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY"
    } else {
      "\"id\" INTEGER PRIMARY KEY"
    }
  }

  column_sql(column: Column, dialect: String) -> String {
    let pg = dialect == "postgres"
    let kind = match column.kind {
      IntColumn -> if pg { "BIGINT" } else { "INTEGER" },
      FloatColumn -> if pg { "DOUBLE PRECISION" } else { "REAL" },
      TextColumn -> "TEXT",
      TimeColumn | NowColumn -> if pg { "TIMESTAMPTZ" } else { "TEXT" },
      BoolColumn -> "BOOLEAN",
    }
    let null = if column.nullable { "" } else { " NOT NULL" }
    let default = match column.kind {
      NowColumn -> if pg {
        " DEFAULT now()"
      } else {
        " DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))"
      },
      _ -> Option.with_default(
        Option.map(column.default, function(value) { " DEFAULT #{literal(value, dialect)}" }),
        "",
      ),
    }
    let references = Option.with_default(
      Option.map(
        column.references,
        function(table) { " REFERENCES #{quote(table)} (\"id\")" },
      ),
      "",
    )
    let on_delete = Option.with_default(
      Option.map(column.on_delete, function(action) { " ON DELETE #{action}" }),
      "",
    )

    "#{quote(column.name)} #{kind}#{null}#{default}#{references}#{on_delete}"
  }

  literal(value: SqlValue, dialect: String) -> String {
    match value {
      SqlNull -> "NULL",
      SqlInt(n) -> "#{n}",
      SqlFloat(x) -> "#{x}",
      SqlText(text) -> "'#{String.replace(text, "'", "''")}'",
      SqlBool(b) -> if dialect == "postgres" {
        if b { "TRUE" } else { "FALSE" }
      } else {
        if b { "1" } else { "0" }
      },
    }
  }

  quote(name: String) -> String {
    "\"#{name}\""
  }

exports
  Migration
  Change
  Column
  ColumnKind
  Index
  up_sql
  down_sql
  up_sql_for
  down_sql_for
  sql
  sql_for
