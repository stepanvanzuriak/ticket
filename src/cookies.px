module Cookies

uses
  Std.List
  Std.Map
  Std.Option
  Std.Url

functions
  parse(header: String) -> Map<String, String> {
    List.fold(
      String.split(header, ";"),
      Map.empty(),
      function(map, piece) {
        match String.split_once(String.trim(piece), "=") {
          Some(pair) if pair.before != "" -> Map.insert(
            map,
            pair.before,
            Url.decode(pair.after),
          ),
          _ -> map,
        }
      },
    )
  }

exports
  parse
