module Action

uses
  Ticket.Conn
  Std.{Http, List, Result}

types
  Filter = function(Conn) -> Result<Response, Conn>

functions
  before(
    filters: List<function(Conn) -> Result<Response, Conn> / {| e}>,
    action: function(Conn) -> Response / {| e},
  ) -> function(Conn) -> Response / {| e} {
    function(conn) {
      match List.fold(filters, Ok(conn), Result.and_then) {
        Ok(passed) -> action(passed),
        Err(response) -> response,
      }
    }
  }

exports
  Filter
  before
