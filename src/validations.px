module Validations

uses
  Std.Id
  Std.List
  Std.Option
  Std.Regex
  Std.Time
  Ticket.Errors

traits
  Blank<a> {
    blank(value: a) -> Bool
  }

  Sized<a> {
    size(value: a) -> Int
  }

functions
  presence(errors: Errors, field: String, value: a) -> Errors where Blank<a> {
    if blank(value) { Errors.add(errors, field, "can't be blank") } else { errors }
  }

  length_between(errors: Errors, field: String, value: a, min: Int, max: Int) -> Errors where Sized<a> {
    length_at_most(length_at_least(errors, field, value, min), field, value, max)
  }

  length_at_least(errors: Errors, field: String, value: a, min: Int) -> Errors where Sized<a> {
    if size(value) < min {
      Errors.add(errors, field, "is too short (minimum is #{min} #{characters(min)})")
    } else {
      errors
    }
  }

  length_at_most(errors: Errors, field: String, value: a, max: Int) -> Errors where Sized<a> {
    if size(value) > max {
      Errors.add(errors, field, "is too long (maximum is #{max} #{characters(max)})")
    } else {
      errors
    }
  }

  inclusion(errors: Errors, field: String, value: a, allowed: List<a>) -> Errors where Eq<a> {
    if List.any(allowed, function(x) { x == value }) {
      errors
    } else {
      Errors.add(errors, field, "is not included in the list")
    }
  }

  format(errors: Errors, field: String, value: String, pattern: String) -> Errors {
    if Regex.matches(pattern, value) { errors } else { Errors.add(errors, field, "is invalid") }
  }

  uniqueness(errors: Errors, field: String, others: Int) -> Errors {
    if others > 0 { Errors.add(errors, field, "has already been taken") } else { errors }
  }

  characters(count: Int) -> String {
    if count == 1 { "character" } else { "characters" }
  }

impls
  Blank for String {
    blank(value) {
      String.trim(value) == ""
    }
  }

  Blank for Int {
    blank(_) {
      false
    }
  }

  Blank for Float {
    blank(_) {
      false
    }
  }

  Blank for Bool {
    blank(_) {
      false
    }
  }

  Blank for Time {
    blank(_) {
      false
    }
  }

  Blank for Id<r> {
    blank(_) {
      false
    }
  }

  Blank for List<a> {
    blank(value) {
      List.is_empty(value)
    }
  }

  Blank for Option<a> where Blank<a> {
    blank(value) {
      match value {
        None -> true,
        Some(x) -> blank(x),
      }
    }
  }

  Sized for String {
    size(value) {
      String.length(value)
    }
  }

  Sized for List<a> {
    size(value) {
      List.length(value)
    }
  }

  Sized for Option<a> where Sized<a> {
    size(value) {
      match value {
        None -> 0,
        Some(x) -> size(x),
      }
    }
  }

exports
  Blank { blank }
  Sized { size }
  presence
  length_between
  length_at_least
  length_at_most
  inclusion
  format
  uniqueness
