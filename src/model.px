module Model

uses
  Std.{Id, Json, List, Option, Result}
  Ticket.{Db, Query, Sql}

hosts
  Node

types
  Total = { n: Int } derive(Json)

  Measured = { n: String } derive(Json)

functions
  find(table: String, id: Id<r>) -> Option<a> / {Db, Throws<DbFailure>} where Json<a> {
    rows(Sql.find(table, Id.value(id))) |> List.head
  }

  all(table: String) -> List<a> / {Db, Throws<DbFailure>} where Json<a> {
    rows(Sql.select(table, [], []))
  }

  filter(table: String, filters: List<Filter<r>>, clauses: List<Clause<r>>) -> List<a> / {
    Db,
    Throws<DbFailure>,
  } where Json<a> {
    rows(Sql.select(table, filters, clauses))
  }

  count(table: String, filters: List<Filter<r>>) -> Int / {Db, Throws<DbFailure>} {
    let totals: List<Total> = rows(Sql.count(table, filters))

    match List.head(totals) {
      Some(total) -> total.n,
      None -> 0,
    }
  }

  paginate(
    table: String,
    filters: List<Filter<r>>,
    clauses: List<Clause<r>>,
    page: Int,
    per_page: Int,
  ) -> Page<a> / {Db, Throws<DbFailure>} where Json<a> {
    let size = if per_page < 1 { 1 } else { per_page }
    let current = if page < 1 { 1 } else { page }
    let total = count(table, filters)
    let paged = List.append(
      clauses,
      [Query.limit(size), Query.offset((current - 1) * size)],
    )

    {
      rows: rows(Sql.select(table, filters, paged)),
      page: current,
      per_page: size,
      total: total,
      pages: (total + size - 1) / size,
    }
  }

  measure(
    table: String,
    function_name: String,
    column: Column<r, a>,
    filters: List<Filter<r>>,
  ) -> Option<a> / {Db, Throws<DbFailure>} {
    let found: List<Measured> = rows(
      Sql.aggregate(table, function_name, Query.name(column), filters),
    )

    match List.head(found) {
      Some(row) -> match Query.measure(column, row.n) {
        Ok(value) -> value,
        Err(message) -> throw DbFailure(
          {
            kind: "decode",
            code: "",
            message: "an aggregate doesn't decode: #{message}",
            sql: "",
          },
        ),
      },
      None -> None,
    }
  }

  insert(table: String, columns: List<String>, params: List<SqlValue>) -> a / {
    Db,
    Throws<DbFailure>,
  } where Json<a> {
    returned(Sql.insert(table, columns, params))
  }

  update(
    table: String,
    columns: List<String>,
    params: List<SqlValue>,
    id: Id<r>,
    touch: Bool,
  ) -> a / {Db, Throws<DbFailure>} where Json<a> {
    returned(Sql.update(table, columns, params, Id.value(id), touch))
  }

  delete(table: String, id: Id<r>) -> Bool / {Db, Throws<DbFailure>} {
    let statement = Sql.delete(table, Id.value(id))

    match Db.exec(statement.sql, statement.params) {
      Ok(changes) -> changes.changes > 0,
      Err(error) -> throw DbFailure(error),
    }
  }

  rows(statement: Statement) -> List<a> / {Db, Throws<DbFailure>} where Json<a> {
    let found: Result<DbError, List<a>> = Db.all(statement.sql, statement.params)

    match found {
      Ok(list) -> list,
      Err(error) -> throw DbFailure(error),
    }
  }

  returned(statement: Statement) -> a / {Db, Throws<DbFailure>} where Json<a> {
    let list: List<a> = rows(statement)

    match List.head(list) {
      Some(row) -> row,
      None -> throw DbFailure(
        { kind: "not_found", code: "", message: "no row matched", sql: statement.sql },
      ),
    }
  }

exports
  find
  all
  filter
  count
  paginate
  measure
  insert
  update
  delete
