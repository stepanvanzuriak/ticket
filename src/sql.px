module Sql

uses
  Std.List
  Std.Option
  Ticket.Db
  Ticket.Query

types
  Statement = { sql: String, params: List<SqlValue> }

  Parts = { orders: List<String>, limit: Option<Int>, offset: Option<Int> }

functions
  find(table: String, id: Int) -> Statement {
    { sql: "SELECT * FROM #{quote(table)} WHERE \"id\" = ?", params: [SqlInt(id)] }
  }

  select(table: String, filters: List<Filter<r>>, clauses: List<Clause<r>>) -> Statement {
    let parts = List.fold(clauses, { orders: [], limit: None, offset: None }, add_clause)
    let order = if List.is_empty(parts.orders) {
      ""
    } else {
      " ORDER BY #{List.join(parts.orders, ", ")}"
    }

    {
      sql: "SELECT * FROM #{quote(table)}#{conditions(filters)}#{order}#{paging(parts)}",
      params: values(filters),
    }
  }

  count(table: String, filters: List<Filter<r>>) -> Statement {
    {
      sql: "SELECT COUNT(*) AS n FROM #{quote(table)}#{conditions(filters)}",
      params: values(filters),
    }
  }

  insert(table: String, columns: List<String>, params: List<SqlValue>) -> Statement {
    if List.is_empty(columns) {
      { sql: "INSERT INTO #{quote(table)} DEFAULT VALUES RETURNING *", params: [] }
    } else {
      let marks = List.join(List.map(columns, function(_) { "?" }), ", ")
      let names = List.join(List.map(columns, quote), ", ")

      {
        sql: "INSERT INTO #{quote(table)} (#{names}) VALUES (#{marks}) RETURNING *",
        params: params,
      }
    }
  }

  update(
    table: String,
    columns: List<String>,
    params: List<SqlValue>,
    id: Int,
    touch: Bool,
  ) -> Statement {
    let sets = List.map(columns, function(column) { "#{quote(column)} = ?" })
    let all = if touch {
      List.append(sets, ["\"updated_at\" = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')"])
    } else {
      sets
    }

    if List.is_empty(all) {
      find(table, id)
    } else {
      {
        sql: "UPDATE #{quote(table)} SET #{List.join(all, ", ")} WHERE \"id\" = ? RETURNING *",
        params: List.append(params, [SqlInt(id)]),
      }
    }
  }

  delete(table: String, id: Int) -> Statement {
    { sql: "DELETE FROM #{quote(table)} WHERE \"id\" = ?", params: [SqlInt(id)] }
  }

  conditions(filters: List<Filter<r>>) -> String {
    if List.is_empty(filters) {
      ""
    } else {
      let parts = List.map(
        filters,
        function(filter) {
          match filter {
            Filter(sql, _) -> "(#{sql})",
          }
        },
      )

      " WHERE #{List.join(parts, " AND ")}"
    }
  }

  values(filters: List<Filter<r>>) -> List<SqlValue> {
    List.concat_map(
      filters,
      function(filter) {
        match filter {
          Filter(_, params) -> params,
        }
      },
    )
  }

  add_clause(parts: Parts, clause: Clause<r>) -> Parts {
    match clause {
      OrderBy(column, descending) -> {
        let direction = if descending { "DESC" } else { "ASC" }

        {
          orders: List.append(parts.orders, ["#{column} #{direction}"]),
          limit: parts.limit,
          offset: parts.offset,
        }
      }
      Limit(count) -> { orders: parts.orders, limit: Some(count), offset: parts.offset },
      Offset(count) -> { orders: parts.orders, limit: parts.limit, offset: Some(count) },
    }
  }

  paging(parts: Parts) -> String {
    match parts.limit {
      Some(count) -> " LIMIT #{count}#{skipping(parts.offset)}",
      None -> match parts.offset {
        Some(skip) -> " LIMIT -1 OFFSET #{skip}",
        None -> "",
      },
    }
  }

  skipping(offset: Option<Int>) -> String {
    match offset {
      Some(skip) -> " OFFSET #{skip}",
      None -> "",
    }
  }

  quote(name: String) -> String {
    "\"#{name}\""
  }

exports
  Statement
  find
  select
  count
  insert
  update
  delete
